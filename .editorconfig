# EditorConfig: https://editorconfig.org
#
# Pins what the repository already does, so an editor stops guessing. gofmt
# and cargo fmt remain the authority for Go and Rust code; this file covers
# what they do not (YAML, Markdown, shell, JSON, TOML) and keeps editors from
# fighting them. Checked against every tracked file with editorconfig-checker:
# adding it changed nothing.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt indents with tabs.
[*.go]
indent_style = tab

# Make requires tabs in recipes.
[Makefile]
indent_style = tab

# cargo fmt: four spaces.
[*.rs]
indent_style = space
indent_size = 4

[*.{toml,py}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4

# Markdown: two trailing spaces are a hard line break, and fenced code blocks
# reproduce whatever they quote, so neither is normalised.
[*.md]
trim_trailing_whitespace = false

# Captured or generated byte-for-byte: source fixtures, recorded responses,
# preimages and Soroban test snapshots. Editing them breaks the hashes and
# digests they are checked against, so an editor must leave them alone.
[{**/testdata/**,**/test_snapshots/**,conformance/**,docs/eval-baseline.json}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
